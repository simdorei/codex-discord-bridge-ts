{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(exec|functions\\.exec|js|mcp__node_repl__js|node_repl\\.js)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/bin/cdr-pro-helper.mjs\" connector-hook",
            "commandWindows": "node \"${PLUGIN_ROOT}\\bin\\cdr-pro-helper.mjs\" connector-hook",
            "timeout": 10,
            "statusMessage": "Verifying Pro OAuth connector"
          }
        ]
      }
    ]
  }
}
