# Copy to .env in your runtime directory; keep credentials outside npm's directory.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_ALLOWED_CHANNEL_IDS=
# Optional: limit access to these comma-separated Discord user IDs.
DISCORD_ALLOWED_USER_IDS=
DISCORD_ALLOW_ALL_CHANNELS=0
DISCORD_STARTUP_CHANNEL_ID=
DISCORD_STARTUP_NOTIFY=1
DISCORD_ENABLE_MESSAGE_CONTENT=1
DISCORD_HISTORY_POLL_SECONDS=15
DISCORD_STREAM_COMMENTARY=1
# Fresh installs match Rust. Migrate existing Rust/older TS cursors before reuse.
DISCORD_SESSION_MIRROR=1
DISCORD_ENABLE_ATTACHMENTS=1
DISCORD_ATTACHMENT_MAX_BYTES=26214400
DISCORD_ATTACHMENT_TEXT_INLINE_MAX_BYTES=32768
# Opt in to Windows host restart/recovery commands.
DISCORD_ENABLE_HOST_COMMANDS=0
# Existing Codex installation is discovered automatically. Overrides are optional.
# CODEX_EXE=C:\Users\you\AppData\Local\OpenAI\Codex\bin\version\codex.exe
# CODEX_HOME=C:\Users\you\.codex
# CODEX_DISCORD_ROOT=C:\codex-discord
